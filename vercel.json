{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "index.js"
    },
    {
      "src": "/(.*)",
      "dest": "index.html"
    }
  ],
  "crons": [
    { "path": "/api/cron/yearly-summary", "schedule": "0 17 31 12 *" },
    { "path": "/api/cron/yearly-summary", "schedule": "0 17 1 1 *" }
  ]
}